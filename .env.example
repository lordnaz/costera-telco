# COSTERA — server-side only. Never commit real values, never expose to the client.
# Local dev: copy this file to .env (or .dev.vars for wrangler) and fill in values yourself.
# Deployed: set these as encrypted environment variables in Cloudflare Pages settings.
# The base URL must include the /compatible-mode/v1/ path suffix.
COSTERA_API_KEY=replace-with-your-key
COSTERA_API_BASE_URL=https://replace-with-your-maas-host/compatible-mode/v1